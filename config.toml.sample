[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# Multi-tenancy (fork-only feature, not upstream). When enabled, every
# request must arrive on a subdomain of root_domain (<slug>.root_domain)
# identifying an active tenant, or it's rejected. Leave disabled (default)
# for a normal single-tenant install - nothing else changes.
multi_tenancy_enabled = false
root_domain = ""

# The listnun console (e.g. "https://listnun.app"). When set, opening the
# admin UI of a suspended tenant redirects to <console_url>/billing (and a
# disabled one to <console_url>) instead of returning a bare 503. Public
# subscriber routes and the API still get the 503. Leave empty to disable.
console_url = ""

# Developers > Webhooks only calls public HTTPS endpoints. Set this to true
# to allow plain HTTP and private/loopback addresses, for local development
# only: on a shared install it lets workspaces reach internal hosts.
webhooks_allow_private = false

# Database.
[db]
host = "localhost"
port = 5432
user = "listnun"
password = "listnun"

# Ensure that this database has been created in Postgres.
database = "listnun"

ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"

# Optional space separated Postgres DSN params. eg: "application_name=listnun gssencmode=disable"
params = ""

# Operator API (fork-only, multi-tenancy companion feature, not upstream).
# A separate, cross-tenant API for provisioning/managing tenants - distinct
# from the tenant-facing app, authenticated by a single static bearer
# token instead of user sessions. Leave token empty (default) to disable
# it entirely; this is an advanced feature most single-tenant installs
# will never need. See docs/design/multi-tenancy.md's "Operator API"
# section before enabling this in production.
[operator]
token = ""

# Campaign reply tracking (a campaign's "Track replies" switch). Off unless
# inbound_address is set. Replies to tracked campaigns go to a per-message
# address plus-addressed onto inbound_address (e.g. Postmark's
# "<hash>@inbound.postmarkapp.com"); the provider's inbound webhook posts
# them to /webhooks/replies/postmark with these basic-auth credentials,
# e.g. https://user:pass@your-host/webhooks/replies/postmark. secret signs
# the token in each address (16+ characters); changing it orphans replies
# to emails already sent.
#[replies]
#inbound_address = ""
#secret = ""
#webhook_username = ""
#webhook_password = ""

# DB credentials for a *separate* Postgres role with the BYPASSRLS
# attribute, connecting to the same host/port/database as [db] above -
# required because listing/aggregating data across every tenant at once
# is impossible under Row-Level Security using the normal app role (which
# must never have BYPASSRLS). Leave empty to use [db]'s own credentials
# (only appropriate for local development, never production - see the
# design doc for how to create this role).
db_user = ""
db_password = ""

# Set to "dev" to distinguish this instance's tenant subdomains from a
# separate prod deployment sharing the same root_domain - generated/
# resolved tenant URLs become <slug>-dev.root_domain instead of
# <slug>.root_domain. Leave empty (default) for prod - no suffix.
env = ""

# Listnun's rules for Settings > Inactive cleanup in "Managed" mode. These
# are the defaults; uncomment to change them for every workspace in managed
# mode. Workspaces in "Custom" mode set their own. Invalid values fall back
# to the defaults (with a log line).
# [inactive_cleanup.managed]
# days = 180              # 30-3650 days without activity
# activity = "either"     # opened, clicked or either
# action = "unsubscribe"  # unsubscribe, blocklist or delete
# list_ids = []           # empty: all lists
# schedule = "0 2 * * 0"  # cron: Sundays 02:00
